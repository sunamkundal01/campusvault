# ===== Site =====
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Used by NextAuth/Auth.js to sign JWTs in cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me

# ===== Google OAuth (for student login) =====
# Create at https://console.cloud.google.com  → APIs & Services → Credentials → OAuth Client ID (Web app)
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Hard rule enforced server-side, regardless of the OAuth screen.
ALLOWED_EMAIL_DOMAIN=nitsri.ac.in

# Comma-separated list of admin emails (bootstrap; the first matching user becomes admin on first login).
ADMIN_EMAILS=sunam_2022bcse039@nitsri.ac.in

# ===== Drive service account (for storing OA files) =====
# Create a separate service account in the same Google Cloud project.
# Enable Drive API. Create a Drive folder, share it with the SA email (Editor).
# Paste the service account key JSON, base64-encoded, on one line:
#   cat sa-key.json | base64 -w0
DRIVE_SA_KEY_B64=
DRIVE_PARENT_FOLDER_ID=

# ===== View-token signing (independent from AUTH_SECRET) =====
# Used to sign 60-second file view tokens.
# Generate with: openssl rand -base64 32
VIEW_TOKEN_SECRET=replace-me

# ===== Database (Turso / libSQL) =====
# Local dev: file:./local.db
# Prod: libsql://<your-db>.turso.io  + token
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=

# ===== Cron =====
# Shared secret in `Authorization: Bearer <CRON_SECRET>` header for cron-triggered endpoints.
CRON_SECRET=replace-me

# ===== Upload quotas =====
QUOTA_BYTES_PER_USER=524288000        # 500 MB
QUOTA_FILES_PER_DAY=20
QUOTA_MAX_PDF_MB=25
QUOTA_MAX_IMG_MB=5
QUOTA_MAX_ZIP_MB=100
